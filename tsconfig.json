{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./src/lib/db"],
      "@workspace/api-zod": ["./src/lib/api-zod"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
