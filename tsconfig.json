{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", 
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./src/lib/db"],
      "@workspace/api-zod": ["./src/lib/api-zod"]
    }
  },
  "include": ["src/**/*"]
}
}
